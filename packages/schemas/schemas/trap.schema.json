{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avoidingdatapitfalls.com/schemas/trap.schema.json",
  "title": "Trap",
  "description": "A labeled moment in datapitfalls bench where a pitfall is likely to bite.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "start_month",
    "pitfall_ids",
    "affected_questions",
    "ground_truth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "data",
        "definition",
        "goal"
      ]
    },
    "start_month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "end_month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "pitfall_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "An Avoiding Data Pitfalls rule id (kebab-case slug), e.g. multiple-comparisons."
      }
    },
    "affected_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ground_truth": {
      "type": "string",
      "minLength": 1,
      "description": "What is really going on, in plain words."
    },
    "evidence_query": {
      "type": "string",
      "description": "SQL that shows the trap in the data."
    }
  }
}
